{
  "buildCommand": "pnpm --filter @workspace/netplay run build",
  "outputDirectory": "artifacts/netplay/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    {
      "source": "/((?!api/|assets/|favicon.ico|manifest.json|OneSignalSDKWorker.js|OneSignalSDKUpdaterWorker.js).*)",
      "destination": "/index.html"
    }
  ]
}
