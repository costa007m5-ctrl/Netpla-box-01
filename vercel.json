{
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm install && pnpm --filter @workspace/netplay run build:vercel",
  "outputDirectory": "artifacts/netplay/dist/public",
  "functions": {
    "artifacts/netplay/api/index.ts": {
      "includeFiles": "artifacts/api-server/src/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/artifacts/netplay/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
